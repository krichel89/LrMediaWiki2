Thumbs.db
desktop.ini

# Bauergebnisse der Hintergrund-App.
#
# Quelltext ist bridge/sdcbridge.go, gebaut wird mit ./baue-bruecke.sh. Die
# fertigen Programme gehoeren ins Release-ZIP, nicht in die Versionshistorie:
# Git kann Binaerdateien nicht gegeneinander komprimieren, jede neue Fassung
# waeren also rund fuenf Megabyte neue Objekte pro Plattform und Release, die
# jeder Klon vollstaendig mitzieht. Ausserdem ist die notarisierte Fassung
# nicht bytegleich mit der gebauten, eine committete Binaerdatei wuerde also
# Nachvollziehbarkeit nur vortaeuschen.
mediawiki.lrdevplugin/bin/

# Go-Bauergebnisse, falls direkt im Quellordner gebaut wird
bridge/sdcbridge
bridge/sdcbridge.exe
bridge/*.test

# Auslieferungspakete. packe.sh legt beide in dist/ ab.
dist/
LrMediaWiki2-*.zip

# Eigene Workflow-Anpassungen des Nutzers – gehoeren niemandem sonst
mediawiki.lrdevplugin/workflows-eigene.toml
